[Unit]
Description=ROS Launch Service

[Service]
Type=simple
User=root
WorkingDirectory=/home/bxi
Environment=ROS_DOMAIN_ID=XX
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=ROS_LOCALHOST_ONLY=0
Environment='CYCLONEDDS_URI=<CycloneDDS><Domain Id="any"><General><Interfaces><NetworkInterface name="lo" multicast="true"/></Interfaces><AllowMulticast>true</AllowMulticast></General></Domain></CycloneDDS>'
ExecStart=/bin/bash -lc "source /home/bxi/bxi_ws/bxi_rl_controller_ros2_example/install/setup.bash && exec ros2 launch remote_controller remote_controller.launch.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
