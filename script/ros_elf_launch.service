[Unit]
Description=ROS Launch Service
Wants=network.target
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/bxi
Environment=ROS_DOMAIN_ID=XX
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ExecStartPre=/bin/bash -lc "for i in {1..50}; do if /usr/sbin/ip -o -4 addr show scope global up 2>/dev/null | grep -q 'inet '; then exit 0; fi; sleep 0.1; done; exit 0"
ExecStart=/bin/bash -lc "source /home/bxi/bxi_ws/bxi_rl_controller_ros2_example/install/setup.bash && exec ros2 launch remote_controller remote_controller.launch.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
