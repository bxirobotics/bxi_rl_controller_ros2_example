<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bxi_depth_camera</name>
  <version>0.1.0</version>
  <description>Hot-pluggable multi-vendor depth camera publisher for ROS 2.</description>
  <maintainer email="popsay@163.com">liufq</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>opencv</depend>

  <exec_depend>libusb-1.0</exec_depend>
  <exec_depend>libudev-dev</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
